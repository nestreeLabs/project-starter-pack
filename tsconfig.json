{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@data/*": ["./src/@data/*"],
      "@core/*": ["./core/*"],
      "@common/*": ["./src/@common/*"],
      "@components/*": ["./src/@components/*"],
      "@ui/*": ["./src/@ui/*"],
      "@sections/*": ["./src/@sections/*"],
      "@layout/*": ["./src/layout/*"],
      "@views/*": ["./src/@views/*"],
      "@utils/*": ["./src/@utils/*"],
      "@types": ["./src/types.ts"]
    }
  }
}
