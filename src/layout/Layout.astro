---
import "./common.css";

import SEO from "@common/SEO/SEO.astro";
import Fonts from "@common/Fonts/Fonts.astro";

import type { ILayout } from "@types";

type Props = ILayout;

const { meta, lang = "ru" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Fonts />
    <SEO {...meta} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
